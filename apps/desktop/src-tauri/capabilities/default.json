{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "claude",
          "cmd": "claude",
          "args": true,
          "sidecar": false
        },
        {
          "name": "claude-local",
          "cmd": "$HOME/.local/bin/claude",
          "args": true,
          "sidecar": false
        },
        {
          "name": "claude-npm",
          "cmd": "$HOME/.npm-global/bin/claude",
          "args": true,
          "sidecar": false
        },
        {
          "name": "claude-homebrew",
          "cmd": "/opt/homebrew/bin/claude",
          "args": true,
          "sidecar": false
        },
        {
          "name": "claude-usr-local",
          "cmd": "/usr/local/bin/claude",
          "args": true,
          "sidecar": false
        },
        {
          "name": "npm",
          "cmd": "npm",
          "args": true,
          "sidecar": false
        },
        {
          "name": "npm-nvm",
          "cmd": "$HOME/.nvm/versions/node/v22.16.0/bin/npm",
          "args": true,
          "sidecar": false
        },
        {
          "name": "pnpm",
          "cmd": "pnpm",
          "args": true,
          "sidecar": false
        },
        {
          "name": "bash",
          "cmd": "/bin/bash",
          "args": true,
          "sidecar": false
        },
        {
          "name": "zsh",
          "cmd": "/bin/zsh",
          "args": true,
          "sidecar": false
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "claude",
          "cmd": "claude",
          "args": true,
          "sidecar": false
        },
        {
          "name": "claude-local",
          "cmd": "$HOME/.local/bin/claude",
          "args": true,
          "sidecar": false
        },
        {
          "name": "claude-npm",
          "cmd": "$HOME/.npm-global/bin/claude",
          "args": true,
          "sidecar": false
        },
        {
          "name": "claude-homebrew",
          "cmd": "/opt/homebrew/bin/claude",
          "args": true,
          "sidecar": false
        },
        {
          "name": "claude-usr-local",
          "cmd": "/usr/local/bin/claude",
          "args": true,
          "sidecar": false
        },
        {
          "name": "npm",
          "cmd": "npm",
          "args": true,
          "sidecar": false
        },
        {
          "name": "npm-nvm",
          "cmd": "$HOME/.nvm/versions/node/v22.16.0/bin/npm",
          "args": true,
          "sidecar": false
        },
        {
          "name": "pnpm",
          "cmd": "pnpm",
          "args": true,
          "sidecar": false
        },
        {
          "name": "bash",
          "cmd": "/bin/bash",
          "args": true,
          "sidecar": false
        },
        {
          "name": "zsh",
          "cmd": "/bin/zsh",
          "args": true,
          "sidecar": false
        }
      ]
    },
    "shell:allow-kill",
    "pty:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-remove",
    "fs:allow-write",
    "fs:allow-write-text-file",
    "fs:allow-copy-file",
    "fs:scope-home-recursive",
    "fs:scope-appdata-recursive",
    "fs:scope-temp-recursive"
  ]
}
