{
  "name": "guardrail",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted prototyping with design system enforcement",
  "scripts": {
    "dev": "pnpm --filter desktop tauri dev",
    "build": "turbo run build",
    "build:ui": "pnpm --filter @guardrail/ui build",
    "build:desktop": "pnpm --filter desktop tauri build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
